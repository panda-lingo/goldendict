# Compose bind mount (host path)
GOLDENDICT_DICTIONARY_PATH=./dictionaries

# GoldenDict-ng checkout used as the named native build context. A linked Git
# worktree is supported by `make build-backend-native`, which calculates the
# pinned source attestation before Docker copies the named context.
GOLDENDICT_NG_SOURCE=../goldendict-ng

# CI can reject intentional local GoldenDict-ng source changes. Ordinary local
# development leaves this off and records the diff digest in worker metadata.
GOLDENDICT_NG_REQUIRE_CLEAN=OFF

# REST service
GOLDENDICT_DICTIONARY_ROOTS=/dictionaries
GOLDENDICT_STARTUP_SCAN=true
GOLDENDICT_RUNTIME_CATALOG_MUTATIONS=false
GOLDENDICT_NATIVE_WORKER=/usr/local/bin/goldendict-native-worker
GOLDENDICT_NATIVE_INDEX_DIR=/var/lib/goldendict/indices
GOLDENDICT_NATIVE_REQUIRED=true
GOLDENDICT_MDICT_CACHE_BYTES=33554432
GOLDENDICT_MDICT_MAX_BLOCK_BYTES=134217728
GOLDENDICT_MDICT_MAX_ARTICLE_BYTES=33554432
GOLDENDICT_MAX_RESOURCE_BYTES=134217728
# The demo's sandboxed script mode has an opaque browser origin serialized as
# `null`; include it so opted-in dictionary JavaScript can fetch API resources.
GOLDENDICT_CORS_ORIGINS=http://localhost:5173,null
